# Local development template. Use deploy/cpanel.env.example for production.
# No credentials are included. Set database details before running setup.
APP_NAME=TISHEH
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8001
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tisheh
DB_USERNAME=tisheh
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=warning
MAIL_MAILER=log
TRUSTED_PROXIES=

# Production: self. Development iframe preview only: *
CSP_FRAME_ANCESTORS="'self'"
# Needed only for optional compose.mysql.yaml
DB_ROOT_PASSWORD=

# Explicit local/testing opt-in only; forcibly disabled in production
TISHEH_DEMO_ENABLED=false
TISHEH_DEMO_OTP_ENABLED=false
DEMO_OTP_MOBILES=
# Reserved placeholders: real adapter is NOT implemented
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=

# Awaiting-seller reservations; scheduler required
ORDER_RESERVATION_HOURS=24
